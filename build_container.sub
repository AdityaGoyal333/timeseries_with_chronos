shell = pwd; ls -lah; echo "=== APPTAINER ==="; which apptainer; apptainer --version; echo "=== DEF FILE ==="; cat chronos.def; echo "=== REQUIREMENTS ==="; ls -lh requirements.yml; echo "=== BUILD ==="; apptainer build chronos.sif chronos.def; echo "EXIT_CODE=$?"

should_transfer_files = YES
transfer_input_files = /home/agoyal33/timeseries_with_chronos/requirements.yml, /home/agoyal33/timeseries_with_chronos/chronos.def

# Logs
output = logs/gpu_$(Cluster)_$(Process).out
error  = logs/gpu_$(Cluster)_$(Process).err
log    = logs/gpu_$(Cluster)_$(Process).log

# Other resources
request_cpus   = 1
request_memory = 10GB
request_disk   = 30GB


queue 1