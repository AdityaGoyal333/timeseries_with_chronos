# gpu_test.sub — CHTC submit file for the default GPU experiment.
#
# Pipeline role
# -------------
# Unzip vitals, run train --mode seasonal (Steps 1–3), then classify
# --head singular --mode seasonal (Steps 4–5), then clean. Does not run
# fine_grained train or concat classify.
#
# After the pipeline, touch/mkdir placeholders so unused FG/concat names
# in transfer_output_files exist (HTCondor holds if a listed file is missing).

stream_output = True

stream_error  = True

shell = bash timeseries_with_chronos/chtc_scripts/unzip_data.sh && /opt/conda/envs/chronos/bin/python -u timeseries_with_chronos/experiment_files/main.py classify --head singular --mode seasonal && bash timeseries_with_chronos/chtc_scripts/clean_data.sh 
container_image =  osdf:///chtc/staging/a/agoyal33/chronos3.sif 

should_transfer_files = YES
transfer_input_files = /home/agoyal33/timeseries_with_chronos, osdf:///chtc/staging/a/agoyal33/vitals_old.tar, osdf:///chtc/staging/a/agoyal33/vitals_multi.tar



# HTCondor has no globs. List seasonal + FG + concat; missing names hold the job.
# Shell `touch` / `mkdir` above creates empty placeholders for unused artifacts.
transfer_output_files = labels_3d.pkl, labels_5d.pkl, labels_7d.pkl, labels_3d_fine_grained.pkl, labels_5d_fine_grained.pkl, labels_7d_fine_grained.pkl, labels_3d_concat.pkl, labels_5d_concat.pkl, labels_7d_concat.pkl, results_3d_focal.pkl, results_5d_focal.pkl, results_7d_focal.pkl, results_3d_focal_fine_grained.pkl, results_5d_focal_fine_grained.pkl, results_7d_focal_fine_grained.pkl, results_3d_focal_concat.pkl, results_5d_focal_concat.pkl, results_7d_focal_concat.pkl, training_curves_3d_focal, training_curves_5d_focal, training_curves_7d_focal, training_curves_3d_focal_fine_grained, training_curves_5d_focal_fine_grained, training_curves_7d_focal_fine_grained, training_curves_3d_focal_concat, training_curves_5d_focal_concat, training_curves_7d_focal_concat, timeseries_with_chronos/data


# Logs
output = logs/gpu_$(Cluster)_$(Process).out
error  = logs/gpu_$(Cluster)_$(Process).err
log    = logs/gpu_$(Cluster)_$(Process).log

# GPU
request_gpus = 1

# Other resources
request_cpus   = 14
request_memory = 32GB
request_disk   = 100GB

# CHTC GPU settings
+WantGPULab = true
+GPUJobLength = "short"

queue 1