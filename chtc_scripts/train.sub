container_image =  osdf:///chtc/staging/a/agoyal33/chronos3.sif

should_transfer_files = YES
# Switch vitals_site_N_unlabelled.tar to match the uncommented --source site_N line.
# Labeled jobs: osdf:///chtc/staging/a/agoyal33/vitals_old.tar (no outcomes needed).
transfer_input_files = /home/agoyal33/timeseries_with_chronos, osdf:///chtc/staging/a/agoyal33/vitals_site_1_unlabelled.tar, osdf:///chtc/staging/a/agoyal33/outcomes.parquet

transfer_output_files = timeseries_with_chronos/data

output = logs/gpu_$(Cluster)_$(Process).out
error  = logs/gpu_$(Cluster)_$(Process).err
log    = logs/gpu_$(Cluster)_$(Process).log

request_gpus = 1
request_cpus   = 4
request_memory = 20GB
request_disk   = 100GB

+WantGPULab = true

queue 1
