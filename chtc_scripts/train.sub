# gpu_test.sub — CHTC submit file for the default GPU experiment.
#
# Classify artifacts go under timeseries_with_chronos/results/ (from __file__).
# mkdir so this directory exists even if classify did not run (HTCondor holds
# if a listed transfer path is missing).

stream_output = True
stream_error  = True


shell = bash timeseries_with_chronos/chtc_scripts/unzip_data.sh && /opt/conda/envs/chronos/bin/python -u timeseries_with_chronos/experiment_files/main.py train --mode fine_grained && bash timeseries_with_chronos/chtc_scripts/clean_data.sh
container_image =  osdf:///chtc/staging/a/agoyal33/chronos3.sif 

should_transfer_files = YES
transfer_input_files = /home/agoyal33/timeseries_with_chronos, osdf:///chtc/staging/a/agoyal33/vitals_old.tar


transfer_output_files = timeseries_with_chronos/data


# Logs
output = logs/gpu_$(Cluster)_$(Process).out
error  = logs/gpu_$(Cluster)_$(Process).err
log    = logs/gpu_$(Cluster)_$(Process).log

# GPU
request_gpus = 1

# Other resources
request_cpus   = 4
request_memory = 20GB
request_disk   = 100GB

# CHTC GPU settings
+WantGPULab = true

queue 1