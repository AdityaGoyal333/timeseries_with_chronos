container_image =  osdf:///chtc/staging/a/agoyal33/chronos4.sif 


should_transfer_files = YES
transfer_input_files = /home/agoyal33/timeseries_with_chronos, osdf:///chtc/staging/a/agoyal33/death_gap_results_updated.parquet 


transfer_output_files = timeseries_with_chronos/results


# Logs
output = logs/gpu_$(Cluster)_$(Process).out
error  = logs/gpu_$(Cluster)_$(Process).err
log    = logs/gpu_$(Cluster)_$(Process).log

# GPU
request_gpus = 1

# Other resources
request_cpus   = 4
request_memory = 20GB
request_disk   = 100GB

# CHTC GPU settings
+WantGPULab = true

queue 1